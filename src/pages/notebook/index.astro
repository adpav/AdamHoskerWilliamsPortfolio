---
import { getCollection } from 'astro:content';
import NotebookLayout from '../../layouts/NotebookLayout.astro';
import { entryTypes } from '../../notebook';

const entries = (await getCollection('notebook', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const base = import.meta.env.BASE_URL;
---

<NotebookLayout
  title="Notebook"
  description="Things I'm thinking about, learning, making and paying attention to."
>
  <main class="content-padding work" id="main-content">
    <div class="flex-column margin-top-2xlarge">
      <h1 class="notebook-heading notebook-heading--size">Note<span class="text-outline">book</span></h1>
      <p class="notebook-intro">
        Things I’m thinking about, learning, making and paying attention to. Work in progress...
      </p>
      {entries.length > 0 ? (
        <ul class="notebook-list">
          {entries.map((entry) => (
            <li class="notebook-card">
              <p class="notebook-type">
                <span class="visually-hidden">Type: </span>{entryTypes[entry.data.type]}
              </p>
              <h2 class="notebook-card-title">
                <a href={`${base}notebook/${entry.id}/`}>{entry.data.title}</a>
              </h2>
              {entry.data.tags.length > 0 && (
                <ul class="notebook-tags" aria-label="Topics">
                  {entry.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p>There are no published Notebook entries yet.</p>
      )}
    </div>
  </main>
</NotebookLayout>
