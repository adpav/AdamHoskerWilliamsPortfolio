---
interface Props {
  title: string;
  description: string;
  current: 'overview' | 'notebook';
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, current, ogTitle = title, ogDescription = description } = Astro.props;
const base = import.meta.env.BASE_URL;
const fonts =
  'https://fonts.googleapis.com/css2?family=Playfair+Display&family=Creepster&family=Silkscreen:wght@700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Emoji&display=swap';
const icons =
  'https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=arrow_outward';
const portfolioUrl = 'https://crypto.hypermatic.com/prototype/m87u0qbi31593/0PMHJTyXLcpQtu8phKC';
const themes = [
  { id: 'light', value: '1', label: 'Light theme', title: 'Light', icon: '🌞' },
  { id: 'dark', value: '2', label: 'Dark theme', title: 'Dark', icon: '🌛' },
  { id: 'nerdy', value: '3', label: 'Nerdy theme', title: 'Nerdy', icon: '🤖' },
  { id: 'spooky', value: '4', label: 'Spooky theme', title: 'Spooky', icon: '💀' },
  { id: 'classy', value: '5', label: 'Bluey theme', title: 'Bluey', icon: '🖋︎' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href={`${base}style.css`} rel="stylesheet" type="text/css" />

  <link rel="preload" href={fonts} as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href={fonts}></noscript>

  <link rel="icon" href={`${base}img/favicon.ico`}>

  <link rel="preload" href={icons} as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href={icons}></noscript>
</head>

<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <div class="grid">

    <header>
      <div class="header_logo sticky">
        <a href={current === 'overview' ? '#' : base} id="return-to-top" class="rotate" aria-label={current === 'overview' ? 'Return to top' : 'Return to overview'}><svg class="logo" xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M24.1,14.2l1.3-.8v7.2l-1.3-.8v-5.6ZM14.6,4.8l11.3,6.8-9.5,5.7,8.9,5.3v12.8l-11.3-6.8,9.5-5.7-8.9-5.3V4.8ZM24.1,23.9l-7.6,4.6,7.6,4.6h0v-9.2ZM15.9,16.2l7.6-4.6-7.6-4.6v9.2ZM15.9,20.3l-1.3-.8v7.2l1.3-.8v-5.6ZM40,20c0,11-9,20-20,20S0,31,0,20,9,0,20,0s20,9,20,20ZM38.5,20C38.5,9.8,30.2,1.5,20,1.5S1.5,9.8,1.5,20s8.3,18.5,18.5,18.5,18.5-8.3,18.5-18.5Z"/>
        </svg></a>
      </div>

      <nav aria-label="Main navigation">
        <ul role="list">
          <li><a href={base} aria-current={current === 'overview' ? 'page' : undefined}>Overview</a></li>
          <li><a href={`${base}notebook/`} aria-current={current === 'notebook' ? 'page' : undefined}>Notebook</a></li>
          <li>
            <a href={portfolioUrl} rel="noopener noreferrer">
              Portfolio <span class="material-symbols-outlined nav-external-icon" aria-hidden="true">arrow_outward</span>
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <aside class="padding-bottom-medium">
      <div class="aside_social-icons">
        <form class="colour-picker" action="">
          <fieldset>
            <legend class="visually-hidden">Pick a colour scheme</legend>
            {themes.map((theme) => (
              <label class="radio-container">
                <input type="radio" name="theme" value={theme.value} aria-label={theme.label} title={theme.title} id={theme.id} checked={theme.id === 'light'} />
                <span class="icon-font icon" aria-hidden="true">{theme.icon}</span>
              </label>
            ))}
          </fieldset>
        </form>
      </div>
    </aside>

    <slot />

    <footer><p class="small-text margin-right-large content-padding"><span class="emoji medium-text">🧔</span>  This website is a showcase of my semantic HTML, CSS, and JavaScript skills, serving as a shop window to my <span><a href={portfolioUrl} rel="noopener noreferrer">portfolio</a></span>.  Designed and built by yours truly. © Adam Hosker-Williams  <span id="current-year"></span></p></footer>

  </div>

  <slot name="scripts" />
  <script is:inline src={`${base}script.js`}></script>
</body>
</html>
